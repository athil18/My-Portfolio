# ================================================================
# MHD Commerce Backend — Production Environment Variables
# ================================================================
# Copy this file to `.env` and fill in all REQUIRED values.
# Variables marked [OPTIONAL] have sensible defaults.
# Variables marked [SENSITIVE] must NEVER be committed to git.
# ================================================================

# ── Core ──────────────────────────────────────────────────────────
NODE_ENV=production                            # REQUIRED: development | test | production | staging
PORT=5000                                      # [OPTIONAL] Default: 5000

# ── Database (Supabase PostgreSQL) ───────────────────────────────
DATABASE_URL=                                  # REQUIRED [SENSITIVE] postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# ── Supabase ─────────────────────────────────────────────────────
SUPABASE_URL=                                  # REQUIRED: https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=                      # REQUIRED: sb_publishable_...
SUPABASE_SECRET_KEY=                           # REQUIRED [SENSITIVE] sb_secret_...
SUPABASE_JWKS_URL=                             # [OPTIONAL] https://PROJECT.supabase.co/rest/v1/auth/jwks

# ── Auth (Legacy JWT — managed by Supabase) ──────────────────────
JWT_SECRET=supabase-managed                    # [OPTIONAL] Kept for backward compat
JWT_REFRESH_SECRET=supabase-managed            # [OPTIONAL] Kept for backward compat

# ── CORS / Frontend ─────────────────────────────────────────────
CORS_ORIGIN=https://your-frontend.vercel.app   # REQUIRED: Production frontend URL
FRONTEND_URL=https://your-frontend.vercel.app  # REQUIRED: Production frontend URL

# ── Email (SMTP) ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com                       # [OPTIONAL] Default: smtp.gmail.com
SMTP_PORT=587                                  # [OPTIONAL] Default: 587
SMTP_USER=                                     # REQUIRED: Gmail address or SMTP username
SMTP_PASS=                                     # REQUIRED [SENSITIVE] Gmail app password or SMTP password

# ── Cloudinary (Image Storage) ──────────────────────────────────
CLOUDINARY_CLOUD_NAME=                         # REQUIRED: Cloudinary cloud name
CLOUDINARY_API_KEY=                            # REQUIRED: Cloudinary API key
CLOUDINARY_API_SECRET=                         # REQUIRED [SENSITIVE] Cloudinary API secret

# ── Redis (Background Jobs) ────────────────────────────────────
REDIS_URL=redis://localhost:6379               # REQUIRED: Redis connection URL (use Railway/Render Redis add-on for production)

# ── Stripe (Payments) ──────────────────────────────────────────
STRIPE_SECRET_KEY=                             # REQUIRED [SENSITIVE] sk_live_... or sk_test_...
STRIPE_PUBLISHABLE_KEY=                        # REQUIRED: pk_live_... or pk_test_...
STRIPE_WEBHOOK_SECRET=                         # REQUIRED [SENSITIVE] whsec_...

# ── Bull Board (Queue Dashboard) ───────────────────────────────
BULL_BOARD_USER=admin                          # [OPTIONAL] Default: admin
BULL_BOARD_PASSWORD=                           # REQUIRED [SENSITIVE] Strong password for /admin/queues

# ── AI Embeddings ──────────────────────────────────────────────
GEMINI_API_KEY=                                # [OPTIONAL] Google Gemini API key for product embeddings
